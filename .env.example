# Copy to .env and fill in. Nothing in here is required for the offline demo.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# Model providers: stub (offline, extractive) | openai | bedrock
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Embeddings: local (hashing, offline) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Storage: local | s3
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=us-west-2

# Limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LLM=20/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/hour
DAILY_TOKEN_BUDGET=200000
MAX_UPLOAD_MB=25

LOG_LEVEL=INFO
LOG_JSON=false
